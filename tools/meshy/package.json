{
  "name": "meshy-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Octane Racer <-> Meshy AI integration: bulk-pull script + MCP server (GLB-only, RAW output).",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "pull": "tsx pull_assets.ts",
    "mcp": "tsx mcp-server/index.ts",
    "build": "tsc",
    "start:mcp": "node dist/mcp-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
