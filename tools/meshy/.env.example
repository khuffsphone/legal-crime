# Meshy integration — local secrets. COPY this file to `.env` and fill in the key.
#   cp tools/meshy/.env.example tools/meshy/.env
#
# tools/meshy/.env is gitignored and MUST NEVER be committed.
# The key is read from the MESHY_API_KEY environment variable ONLY.

MESHY_API_KEY=your_key_here

# Optional: default output dir for `meshy_download_task` (MCP). Absolute path recommended.
# MESHY_OUT_DIR=/absolute/path/to/octane-racer/assets/raw/meshy

# Optional: override the API base (defaults to https://api.meshy.ai)
# MESHY_API_BASE=https://api.meshy.ai
