{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brassmere.invalid/schemas/receipt.schema.json",
  "title": "Brassmere Agent Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event",
    "event_id",
    "task_id",
    "run_id",
    "agent",
    "input_commit",
    "started_at",
    "ended_at",
    "outcome",
    "changed_paths",
    "tests",
    "usage",
    "followups"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "event": { "enum": ["agent_completed", "review_completed", "task_blocked", "brain_synced"] },
    "event_id": { "type": "string", "minLength": 8 },
    "task_id": { "type": "string", "pattern": "^BM-[0-9]{8}-[0-9]{3,}$" },
    "run_id": { "type": "string", "minLength": 1 },
    "agent": { "enum": ["gpt", "codex", "claude", "gemini", "deterministic-workflow"] },
    "model": { "type": ["string", "null"] },
    "prompt_hash": { "type": ["string", "null"] },
    "input_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "brain_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file_id"],
        "properties": { "file_id": { "type": "string" }, "revision": { "type": ["string", "null"] } }
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "outcome": { "enum": ["pass", "rework", "blocked", "fail"] },
    "changed_paths": { "type": "array", "items": { "type": "string" } },
    "commit": { "type": ["string", "null"] },
    "pull_request": { "type": ["integer", "null"] },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "exit_code"],
        "properties": { "command": { "type": "string" }, "exit_code": { "type": "integer" }, "evidence": { "type": ["string", "null"] } }
      }
    },
    "usage": {
      "type": "object",
      "required": ["agent_calls", "estimated_usd"],
      "properties": { "agent_calls": { "type": "integer", "minimum": 0 }, "estimated_usd": { "type": "number", "minimum": 0 } }
    },
    "followups": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
    "escalation_reason": { "type": ["string", "null"] }
  }
}
